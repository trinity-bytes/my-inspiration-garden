{
  "name": "my-inspiration-garden",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "test": "pnpm -r --if-present run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --if-present run typecheck",
    "build": "pnpm -r --if-present run build",
    "deploy": "pnpm --filter @garden/web build && pnpm --filter @garden/api run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "7.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
